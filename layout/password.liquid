<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400..800&display=swap">
    {{ 'mynrg.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --paper: {{ settings.color_paper }};
        --sand: {{ settings.color_sand }};
        --ink: {{ settings.color_ink }};
        --cobalt: {{ settings.color_brand }};
        --cobalt-hover: {{ settings.color_brand | color_darken: 6 }};
        --cobalt-tint: {{ settings.color_brand | color_mix: '#ffffff', 11 }};
      }
    </style>
    {{ content_for_header }}
  </head>
  <body>
    {% render 'icon-sprite' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
