{%- comment -%} Type "yes" or "no" in a cell to show a check or a cross. {%- endcomment -%}
{%- liquid
  assign price_product = collections.all.products.first
  assign live_price = ''
  if price_product
    assign live_price = price_product.price_min | money
  endif
-%}
<section class="sec"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %}>
  <div class="wrap">
    <div class="sec-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <p class="swipe-hint">Swipe the table to compare →</p>
    <div class="table-scroll">
      <table class="compare">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="is-us">{{ section.settings.col_1 | escape }}</th>
            <th scope="col">{{ section.settings.col_2 | escape }}</th>
            <th scope="col">{{ section.settings.col_3 | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              {%- assign cell_keys = 'c1,c2,c3' | split: ',' -%}
              {%- for key in cell_keys -%}
                {%- assign v = block.settings[key] | strip -%}
                {%- if v contains '{price}' and live_price != blank -%}{%- assign v = v | replace: '{price}', live_price -%}{%- endif -%}
                {%- assign vd = v | downcase -%}
                <td{% if forloop.first %} class="is-us"{% endif %}>
                  {%- if vd == 'yes' -%}<svg class="ok" aria-label="Yes"><use href="#i-check"/></svg>
                  {%- elsif vd == 'no' -%}<svg class="no" aria-label="No"><use href="#i-x"/></svg>
                  {%- else -%}{{ v | escape }}{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="fine" style="margin-top:12px">
        {%- if section.settings.footnote_link != blank -%}<a href="{{ section.settings.footnote_link }}" style="color:inherit">{{ section.settings.footnote | escape }}</a>{%- else -%}{{ section.settings.footnote | escape }}{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Your options" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How MyNrg compares." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "IV drips and injections are being sold as the \"real\" way to raise NAD+. Here's the side-by-side." },
    { "type": "text", "id": "col_1", "label": "Your column", "default": "MyNrg" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Clinic IV drip" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "At-home injections" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "IV and injection prices: HealingMaps, 2026." },
    { "type": "text", "id": "footnote_link", "label": "Footnote link", "default": "https://healingmaps.com/nad-therapy-cost/" },
    { "type": "text", "id": "anchor_id", "label": "Section ID (optional)", "default": "compare" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "paragraph", "content": "Type yes or no to show a check or a cross. Type {price} to show your product's starting price. Anything else shows as text." },
        { "type": "text", "id": "label", "label": "Row label", "default": "No needles" },
        { "type": "text", "id": "c1", "label": "Your column", "default": "yes" },
        { "type": "text", "id": "c2", "label": "Column 2", "default": "no" },
        { "type": "text", "id": "c3", "label": "Column 3", "default": "no" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "No needles", "c1": "yes", "c2": "no", "c3": "no" } },
        { "type": "row", "settings": { "label": "No appointment or prescription", "c1": "yes", "c2": "no", "c3": "no" } },
        { "type": "row", "settings": { "label": "Taken at home", "c1": "yes", "c2": "no", "c3": "yes" } },
        { "type": "row", "settings": { "label": "No ongoing plan required", "c1": "yes", "c2": "yes", "c3": "Usually monthly" } },
        { "type": "row", "settings": { "label": "Typical cost", "c1": "From {price} per bottle", "c2": "$429–$879 per session", "c3": "$99–$249 per month" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
