{%- liquid
  assign featured = section.settings.product
  if featured == blank
    assign featured = collections.all.products.first
  endif
-%}
{%- if featured != blank -%}
  <section class="sec sec--sand" id="{{ section.settings.anchor_id | default: 'shop' }}">
    {%- render 'buy-box', product: featured, section: section, heading_tag: 'h2' -%}
  </section>
{%- else -%}
  <section class="sec sec--sand" id="{{ section.settings.anchor_id | default: 'shop' }}">
    <div class="wrap"><p class="lede">Add a product in Shopify, then pick it for this section in the theme editor.</p></div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Buy box",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use your first product." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "kicker", "label": "Small label above title", "default": "MyNrg" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "120 capsules · Daily support for cellular energy*" },
    { "type": "textarea", "id": "bullets", "label": "Benefit bullets", "info": "One per line.", "default": "Supports healthy NAD+ levels*\nMade with resveratrol, a plant antioxidant*\nSupports cellular energy*\nSupports healthy aging*" },
    { "type": "header", "content": "Subscription toggle", "info": "Shows only when the product has a subscription plan (for example from the Shopify Subscriptions app)." },
    { "type": "text", "id": "purchase_label", "label": "Heading", "default": "How do you want it?" },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One-time" },
    { "type": "text", "id": "sub_label", "label": "Subscribe label", "default": "Subscribe" },
    { "type": "text", "id": "once_note", "label": "One-time note", "default": "Buy once. Nothing renews." },
    { "type": "text", "id": "sub_note", "label": "Subscription note", "default": "Delivered on your schedule. Cancel in one click from your account. No call, no email." },
    { "type": "header", "content": "Bottle options", "info": "Options come from the product's variants, e.g. 1 bottle / 2 bottles / 3 bottles." },
    { "type": "text", "id": "pack_label", "label": "Heading", "default": "How many bottles?" },
    { "type": "text", "id": "single_label", "label": "Name when the product has no variants", "default": "1 bottle" },
    { "type": "number", "id": "days_per_bottle", "label": "Days one bottle lasts", "info": "Used for the price per day. 120 capsules at 1 a day = 120.", "default": 120 },
    { "type": "text", "id": "best_badge", "label": "Badge on the lowest price per day", "info": "Leave empty to hide.", "default": "Best value" },
    { "type": "header", "content": "Under the button" },
    { "type": "text", "id": "terms", "label": "Line under the button", "default": "30-day money-back guarantee. Ships to the US & Canada." },
    { "type": "text", "id": "assure_1", "label": "Trust item 1", "default": "No subscription required" },
    { "type": "text", "id": "assure_2", "label": "Trust item 2", "default": "Cancel in one click" },
    { "type": "text", "id": "assure_3", "label": "Trust item 3", "default": "30-day money-back" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." },
    { "type": "header", "content": "Phone sticky bar" },
    { "type": "checkbox", "id": "show_sticky", "label": "Show sticky buy bar", "default": true },
    { "type": "checkbox", "id": "sticky_desktop", "label": "Also show it on desktop", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Sticky bar button", "default": "Shop" },
    { "type": "header", "content": "Link anchor" },
    { "type": "text", "id": "anchor_id", "label": "Section ID", "info": "Buttons linking to #shop scroll here.", "default": "shop" }
  ],
  "blocks": [
    {
      "type": "drawer",
      "name": "Dropdown",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Supplement Facts" },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Hidden on the store until this has text." }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "About this product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Buy box",
      "blocks": [
        { "type": "drawer", "settings": { "title": "Supplement Facts" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
