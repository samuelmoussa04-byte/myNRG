<section class="sec sec--sand"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %}>
  <div class="wrap">
    <div class="sec-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="sci">
      {%- for block in section.blocks -%}
        <article class="sci__card" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}<span class="sci__tag"><svg aria-hidden="true"><use href="#i-person"/></svg>{{ block.settings.tag | escape }}</span>{%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          {%- if block.settings.source_1 != blank or block.settings.source_2 != blank -%}
            <div class="sci__src">
              {%- if block.settings.source_1 != blank -%}
                {%- if block.settings.source_1_url != blank -%}<a href="{{ block.settings.source_1_url }}" target="_blank" rel="noopener">{{ block.settings.source_1 | escape }}</a>{%- else -%}<span>{{ block.settings.source_1 | escape }}</span>{%- endif -%}
              {%- endif -%}
              {%- if block.settings.source_2 != blank -%}
                {%- if block.settings.source_2_url != blank -%}<a href="{{ block.settings.source_2_url }}" target="_blank" rel="noopener">{{ block.settings.source_2 | escape }}</a>{%- else -%}<span>{{ block.settings.source_2 | escape }}</span>{%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="sci-note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "The science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What research in people shows." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The short version: NAD+ is lower in older adults, and in human trials, the NAD+ precursors NMN and NR raised it." },
    { "type": "textarea", "id": "note", "label": "Note under the cards", "default": "Research on how higher NAD+ changes day-to-day energy is still growing. That's why we call MyNrg daily support, and leave the big promises to other brands." },
    { "type": "text", "id": "anchor_id", "label": "Section ID (optional)", "default": "science" }
  ],
  "blocks": [
    {
      "type": "study",
      "name": "Research card",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Studied in people" },
        { "type": "text", "id": "title", "label": "Title", "default": "NAD+ is lower as we age." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "When researchers measured NAD+ in adults of different ages, older people had lower levels, in both blood and skin." },
        { "type": "text", "id": "source_1", "label": "Source 1", "default": "Clement et al., Rejuvenation Research, 2019" },
        { "type": "text", "id": "source_1_url", "label": "Source 1 link", "default": "https://pubmed.ncbi.nlm.nih.gov/30124109/" },
        { "type": "text", "id": "source_2", "label": "Source 2", "default": "Massudi et al., PLoS One, 2012" },
        { "type": "text", "id": "source_2_url", "label": "Source 2 link", "default": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0042357" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science",
      "blocks": [
        { "type": "study" },
        { "type": "study", "settings": { "title": "Precursors raise NAD+ in people.", "text": "In randomized, placebo-controlled trials, healthy adults who took NAD+ precursors had higher NAD+ levels in their blood than those who took a placebo. These studies tested NMN and NR, not NAD+ taken directly.", "source_1": "Martens et al., Nature Communications, 2018", "source_1_url": "https://www.nature.com/articles/s41467-018-03421-7", "source_2": "Yi et al., GeroScience, 2023", "source_2_url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9735188/" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
