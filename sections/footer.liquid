<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <p class="ftr__blurb">{{ section.settings.blurb | escape }}</p>
      {%- if section.settings.menu_1 != blank -%}
        <div>
          <h4>{{ section.settings.heading_1 | escape }}</h4>
          <ul>
            {%- for link in section.settings.menu_1.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.menu_2 != blank -%}
        <div>
          <h4>{{ section.settings.heading_2 | escape }}</h4>
          <ul>
            {%- for link in section.settings.menu_2.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div>
        <h4>{{ section.settings.heading_3 | escape }}</h4>
        <ul>
          {%- if section.settings.contact_link != blank -%}<li><a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }}</a></li>{%- endif -%}
          {%- if settings.support_email != blank -%}<li><span style="color:#B5B8BF;font-size:14px;overflow-wrap:anywhere">{{ settings.support_email | escape }}</span></li>{%- endif -%}
        </ul>
      </div>
    </div>

    {%- if section.settings.show_wordmark -%}
      <p class="ftr__mark" aria-hidden="true">{{ section.settings.wordmark_1 | escape }}<span>{{ section.settings.wordmark_2 | escape }}</span></p>
    {%- endif -%}

    <div class="ftr__legal">
      {%- if section.settings.disclaimer != blank -%}
        <p class="ftr__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
      <div class="ftr__bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
        <span>{{ section.settings.bottom_note | escape }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "About text", "default": "MyNrg is a daily NAD+ and resveratrol supplement for the afternoon wall. Ships to the United States and Canada." },
    { "type": "header", "content": "Column 1" },
    { "type": "text", "id": "heading_1", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Column 2" },
    { "type": "text", "id": "heading_2", "label": "Heading", "default": "Help" },
    { "type": "link_list", "id": "menu_2", "label": "Menu", "default": "footer", "info": "Good place for Shipping, Refund policy, Privacy policy and Terms." },
    { "type": "header", "content": "Column 3 (contact)" },
    { "type": "text", "id": "heading_3", "label": "Heading", "default": "Contact" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Contact us" },
    { "type": "text", "id": "contact_link", "label": "Contact link", "default": "/pages/contact" },
    { "type": "paragraph", "content": "The support email comes from Theme settings > Brand." },
    { "type": "header", "content": "Big logo" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show big logo", "default": true },
    { "type": "text", "id": "wordmark_1", "label": "First part", "default": "My" },
    { "type": "text", "id": "wordmark_2", "label": "Colored part", "default": "Nrg" },
    { "type": "header", "content": "Bottom" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your healthcare provider before use if you are pregnant, nursing, taking medication (including blood thinners), or have a medical condition." },
    { "type": "text", "id": "bottom_note", "label": "Bottom right note", "default": "Ships to the United States and Canada" }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
