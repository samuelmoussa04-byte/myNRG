<section class="promo-alert" aria-labelledby="PromoAlertHeading">
  <div class="wrap">
    <div class="promo-alert__card">
      <div class="promo-alert__content">
        <p class="promo-alert__eyebrow"><span aria-hidden="true"></span> Spooktober special · Every pack</p>
        <h2 class="promo-alert__title" id="PromoAlertHeading">Save 15% on every pack.</h2>
        <p class="promo-alert__text">Discounted prices are shown above—no code needed.</p>
      </div>
      <a class="btn btn--white promo-alert__button" href="#shop">Shop the special <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spooktober offer alert",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Spooktober offer alert"
    }
  ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
