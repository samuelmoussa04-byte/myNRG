{%- assign promo_alert_now = 'now' | date: '%s' | plus: 0 -%}
{%- if promo_alert_now < 1793941200 -%}
  <section class="promo-alert" aria-labelledby="PromoAlertHeading">
    <div class="wrap">
      <div class="promo-alert__card">
        <svg class="promo-alert__spider" viewBox="0 0 48 92" aria-hidden="true" focusable="false">
          <path class="promo-alert__spider-thread" d="M24 0v45" />
          <circle class="promo-alert__spider-body" cx="24" cy="52" r="5" />
          <path class="promo-alert__spider-legs" d="M20 50l-7-5m7 9-8 2m12-6 7-5m-7 9 8 2m-11 0-5 7m9-7 5 7" />
        </svg>
        <div class="promo-alert__content">
          <p class="promo-alert__eyebrow"><span aria-hidden="true"></span> Spooktober special · Extended through Nov 5
            <svg class="promo-alert__pumpkin" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 5c-1.6-2.1-3.1-2.7-4.2-2.4L8.7 5C5.4 4.7 3 7 3 12s2.7 8 9 8 9-2.5 9-8-2.4-7.3-5.7-7L16.2 2.6C15.1 2.3 13.6 2.9 12 5Z" fill="currentColor"/>
              <path d="M12 6v13M8.2 6.2C6.5 8 6.2 15.8 8.5 19M15.8 6.2c1.7 1.8 2 9.6-.3 12.8" fill="none" stroke="#1F4690" stroke-linecap="round" stroke-width="1.1"/>
            </svg>
          </p>
          <h2 class="promo-alert__title" id="PromoAlertHeading">The Spooktober special is still on.</h2>
          <p class="promo-alert__text">Save 36% through November 5. Shop before the offer ends.</p>
        </div>
        <a class="btn btn--white promo-alert__button" href="#shop">Claim the offer <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Final-day offer alert",
  "tag": "div",
  "settings": [],
  "presets": [
    {
      "name": "Extended Spooktober offer alert"
    }
  ],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
