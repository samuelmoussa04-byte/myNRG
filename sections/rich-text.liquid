<section class="sec{% if section.settings.sand %} sec--sand{% endif %}">
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:0">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="lede rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<div class="hero__cta"><a class="btn btn--blue btn--lg" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label | escape }}</a></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text block",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Add a heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add some text.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "sand", "label": "Beige background", "default": false }
  ],
  "presets": [ { "name": "Text block" } ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
