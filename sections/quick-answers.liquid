<section class="sec{% if section.settings.sand %} sec--sand{% endif %}">
  <div class="wrap">
    <div class="sec-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="quick">
      {%- for block in section.blocks -%}
        <article {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quick answers",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Quick answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might not need to wait for us." },
    { "type": "checkbox", "id": "sand", "label": "Beige background", "default": true }
  ],
  "blocks": [
    {
      "type": "answer",
      "name": "Answer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Where's my order?" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Your shipping confirmation email has a tracking link. Can't find it? Send us your order number and we'll check." },
        { "type": "text", "id": "link_label", "label": "Link label (optional)" },
        { "type": "text", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quick answers",
      "blocks": [ { "type": "answer" } ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
