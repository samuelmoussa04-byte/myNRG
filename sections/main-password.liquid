<section class="sec">
  <div class="wrap empty-state">
    <p class="logo" style="font-size:34px">{{ shop.name | escape }}</p>
    <h1 class="h1 h1--page">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lede" style="margin:0">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'search-form' -%}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <input class="field" type="password" name="password" id="Password" autocomplete="current-password" placeholder="Password">
      <button class="btn btn--blue" type="submit">Enter</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
