<section class="sec sec--tight">
  <div class="wrap">
    <div class="note">
      <div class="note__icon"><svg aria-hidden="true"><use href="#i-shield"/></svg></div>
      <div>
        <h3>{{ section.settings.heading | escape }}</h3>
        <p>{{ section.settings.text | escape }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Safety note",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check with your doctor first if…" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "you're pregnant or breastfeeding, take blood thinners or other prescription medication, or have a history of cancer. Resveratrol may interact with blood thinners and some other medications. Long-term data on NAD+ supplements is limited. MyNrg is for adults 18 and over." }
  ],
  "presets": [ { "name": "Safety note" } ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
