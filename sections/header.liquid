<header class="site-header" {{ section.shopify_attributes }}>
  <div class="page-width site-header__inner">
    <a class="site-header__brand" href="{{ routes.root_url }}">
      {{ section.settings.logo_text | default: shop.name | escape }}
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>
    <div class="site-header__actions">
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Store name"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
