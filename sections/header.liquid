{%- assign logo_style = 'height: ' | append: section.settings.logo_height | append: 'px; width: auto;' -%}
{%- if localization.country.iso_code == 'CA' -%}
  {%- assign target_country_code = 'US' -%}
  {%- assign target_currency = 'USD' -%}
{%- else -%}
  {%- assign target_country_code = 'CA' -%}
  {%- assign target_currency = 'CAD' -%}
{%- endif -%}
{%- assign us_available = false -%}
{%- assign ca_available = false -%}
{%- for country in localization.available_countries -%}
  {%- if country.iso_code == 'US' -%}
    {%- assign us_available = true -%}
  {%- elsif country.iso_code == 'CA' -%}
    {%- assign ca_available = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign show_currency_switch = false -%}
{%- if us_available and ca_available -%}
  {%- if localization.country.iso_code == 'US' or localization.country.iso_code == 'CA' -%}
    {%- assign show_currency_switch = true -%}
  {%- endif -%}
{%- endif -%}
<header class="hdr">
  <div class="wrap hdr__in">
    <nav class="hdr__nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>
    <button class="hdr__icon hdr__menu" type="button" data-menu-toggle aria-expanded="false" aria-label="Open menu"><svg aria-hidden="true"><use href="#i-menu"/></svg></button>
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, style: logo_style, loading: 'eager' }}
      {%- else -%}
        {{ section.settings.logo_text_1 | escape }}<span>{{ section.settings.logo_text_2 | escape }}</span>
      {%- endif -%}
    </a>
    <div class="hdr__end">
      {%- if show_currency_switch -%}
        {%- form 'localization', id: 'CurrencyForm', class: 'hdr__currency-form' -%}
          <input type="hidden" name="country_code" value="{{ target_country_code }}">
          <button class="hdr__currency" type="submit" aria-label="Switch currency to {{ target_currency }}">
            {{ localization.country.currency.iso_code }}
          </button>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_button and section.settings.button_label != blank -%}
        <a class="btn btn--blue hdr__btn" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      <a class="hdr__icon" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg aria-hidden="true"><use href="#i-bag"/></svg>
        {%- if cart.item_count > 0 -%}<span class="hdr__count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
  <nav class="wrap hdr__drawer" aria-label="Mobile">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title | escape }}</a>
    {%- endfor -%}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Edit in Online Store > Navigation. Suggested: Shop (#shop), How it works (/#how), The science (/#science), FAQ (/#faq), Contact (/pages/contact)." },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional. If empty, the text logo below is used." },
    { "type": "range", "id": "logo_height", "label": "Logo image height", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "text", "id": "logo_text_1", "label": "Text logo, first part", "default": "My" },
    { "type": "text", "id": "logo_text_2", "label": "Text logo, colored part", "default": "Nrg" },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/#shop" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
