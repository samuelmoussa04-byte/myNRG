{%- if section.blocks.size > 0 -%}
  {%- assign halloween_announcement_now = 'now' | date: '%s' | plus: 0 -%}
  <div class="announce" data-announce>
    <ul>
      {%- for block in section.blocks -%}
        {%- assign announcement_text = block.settings.text | upcase -%}
        {%- unless announcement_text contains 'SPOOKTOBER' and halloween_announcement_now >= 1793941200 -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<svg aria-hidden="true"><use href="#i-{{ block.settings.icon }}"/></svg>{%- endif -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color:inherit;text-decoration:none">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announcement",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Ships to the US & Canada" },
        { "type": "text", "id": "link", "label": "Link (optional)", "info": "For example /pages/contact" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "free", "label": "Unlocked" },
            { "value": "cancel", "label": "Cancel" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" },
            { "value": "none", "label": "None" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Ships to the US & Canada", "icon": "truck" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
