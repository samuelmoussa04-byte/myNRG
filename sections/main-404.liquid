<section class="sec">
  <div class="wrap empty-state">
    <p class="kicker">404</p>
    <h1 class="h1 h1--page">{{ section.settings.heading | escape }}</h1>
    <p class="lede" style="margin:0">{{ section.settings.text | escape }}</p>
    <a class="btn btn--blue btn--lg" href="{{ routes.root_url }}">{{ section.settings.button | escape }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found." },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you're looking for doesn't exist or has moved." },
    { "type": "text", "id": "button", "label": "Button", "default": "Back to home" }
  ]
}
{% endschema %}
