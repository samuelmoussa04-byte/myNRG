<section class="page-width section" {{ section.shopify_attributes }}>
  <h1>Your cart</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {% for item in cart.items %}
          <article class="cart-item">
            <a href="{{ item.url }}">
              {% if item.image %}
                {{
                  item.image
                  | image_url: width: 240
                  | image_tag: class: 'cart-item__image', loading: 'lazy'
                }}
              {% endif %}
            </a>
            <div>
              <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {% unless item.product.has_only_default_variant %}
                <p class="muted">{{ item.variant.title | escape }}</p>
              {% endunless %}
              <p>{{ item.final_line_price | money }}</p>
              <label class="field">
                <span>Quantity</span>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </label>
            </div>
            <a href="{{ item.url_to_remove }}">Remove</a>
          </article>
        {% endfor %}
      </div>
      <div class="cart-summary">
        <button class="button" type="submit" name="update">Update cart</button>
        <strong>Subtotal: {{ cart.total_price | money }}</strong>
        <button class="button" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% else %}
    <p>Your cart is empty.</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
