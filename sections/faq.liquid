<section class="sec"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %}>
  <div class="wrap faq">
    <div class="sec-head" style="margin:0">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<div class="lede">{{ section.settings.intro }}</div>{%- endif -%}
      {%- if section.settings.show_email and settings.support_email != blank -%}<p class="lede" style="margin-top:8px">Or email {{ settings.support_email | escape }}</p>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="qa"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="qa__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions people actually ask." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Something else? <a href=\"/pages/contact\">Send us a message</a>.</p>" },
    { "type": "checkbox", "id": "show_email", "label": "Show support email", "info": "Set the email in Theme settings > Brand.", "default": true },
    { "type": "text", "id": "anchor_id", "label": "Section ID (optional)", "default": "faq" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When should I take it?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>In the morning, with breakfast, before 10am. People who take NAD+ supplements later in the day more often report trouble sleeping.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
