<article class="product-card">
  <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 800
        | image_tag: class: 'product-card__image', loading: 'lazy', widths: '300, 500, 800'
      }}
    {% else %}
      <div class="product-card__image product-card__image--placeholder">No image</div>
    {% endif %}
  </a>
  <div class="product-card__details">
    <a class="product-card__title" href="{{ product.url }}">{{ product.title | escape }}</a>
    <span class="product-card__price">
      {% if product.price_varies %}From {% endif %}{{ product.price | money }}
    </span>
  </div>
</article>
